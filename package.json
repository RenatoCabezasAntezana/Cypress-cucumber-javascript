{
  "name": "project-cypress-framework",
  "version": "1.0.0",
  "description": "project cypress cucumber",
  "main": "index.js",
  "scripts": {
    "test": "cypress open",
    "cypress:execution-tags": "cypress run --browser chrome --headless --env grepTags=@regression"
  },
  "keywords": [
    "cypress",
    "javascript",
    "cucumber",
    "author:",
    "Renato",
    "Cabezas"
  ],
  "author": "Renato Cabezas",
  "license": "ISC",
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^14.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.1.5",
    "cypress": "^11.2.0",
    "cypress-junit-reporter": "^1.3.1",
    "esbuild": "^0.15.18"
  },
  "cypress-cucumber-preprocessor": {
    "json": {
      "enabled": true,
      "output": "cypress/reports/cucumber-results.json",
      "formatter": "./cucumber-json-formatter"
    },
    "messages": {
      "enabled": false
    },
    "stepDefinitions": [
      "cypress/e2e/steps-definitions/*.{js, ts}"
    ]
  }
}
